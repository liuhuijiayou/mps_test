# ---------------------------------------------------------------------------
# Run artifacts.
#
# results/ holds real measurements from a specific machine (GPU UUIDs, PIDs,
# container IDs, raw per-request logs). It is deliberately untracked: results
# belong to the run that produced them, not to the source tree.
# ---------------------------------------------------------------------------
results/

# Machine-specific config. runtime.example.yaml IS tracked; the filled-in
# runtime.yaml contains a real GPU UUID and host-specific device args.
configs/runtime.yaml

# Internal task spec — withheld from the public repo by default.
# Remove this line if you decide it should be published.
prompt.md
